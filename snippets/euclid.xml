  <project path="hardware/interfaces" name="hardware_interfaces" groups="pdk,sysui-studio" remote="euclid" />

  <!-- Lineage SDK  -->
  <project path="lineage-sdk" name="lineage-sdk" remote="euclid" />

  <!-- Frameworks  -->
  <project path="frameworks/av" name="frameworks_av" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="euclid" />
  <project path="frameworks/base" name="frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="euclid" />
  <project path="frameworks/libs/systemui" name="frameworks_libs_systemui" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="euclid" />
