<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="euclid"
           fetch="https://github.com/euclidOS-AOSP"
           revision="refs/heads/16.1" />

  <remote  name="euclid-gitlab"
           fetch="https://gitlab.com/euclidos"
           revision="refs/heads/16.1" />

 <remote  name="euclid-devices"                                         
          fetch="https://github.com/euclid-devices"                          
          revision="refs/heads/16" />

  <!-- euclid additions -->
  <!-- manifest -->
  <project path="manifest" name="manifest" remote="euclid" />

  <!-- art -->
  <project path="art" name="art" remote="euclid" />

  <!-- bionic -->
  <project path="bionic" name="bionic" remote="euclid" />

  <!-- bootable -->
  <project path="bootable/deprecated-ota" name="bootable_deprecated-ota" remote="euclid" />
  <project path="bootable/recovery" name="bootable_recovery" remote="euclid" />

  <!-- build -->
  <project path="build/make" name="build" groups="pdk" remote="euclid" >
    <copyfile src="core/root.mk" dest="Makefile" />
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <project path="build/soong" name="build_soong" groups="pdk,tradefed" remote="euclid" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <!-- device -->
  <project path="device/euclid/sepolicy" name="device_euclid_sepolicy" remote="euclid" />

  <!-- external -->
  <project path="external/avb" name="external_avb" groups="pdk" remote="euclid" />
