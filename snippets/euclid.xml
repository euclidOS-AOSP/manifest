<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote name="euclid"
          fetch="https://github.com/euclidOS-AOSP/"
          sync-c="true"
          sync-j="4"
          revision="refs/heads/16" />

  <remote name="euclid-gitlab"
          fetch="https://gitlab.com/euclidos"
          sync-c="true"
          sync-j="4"
          revision="refs/heads/16" />

  <!-- Android Manifest  -->
  <project path="manifest" name="manifest" remote="euclid" />
  
  <project path="art" name="art" remote="euclid" />
  
  <project path="bionic" name="bionic" groups="pdk" remote="euclid"/>

  <!-- Bootable -->
  <project path="bootable/deprecated-ota" name="bootable_deprecated-ota" groups="pdk-cw" remote="euclid" />
  <project path="bootable/recovery" name="bootable_recovery" groups="pdk-cw" remote="euclid" />

  <!-- Build -->
  <project path="build/bazel" name="build_bazel" groups="pdk" remote="euclid" >
    <linkfile src="bazel.WORKSPACE" dest="WORKSPACE" />
    <linkfile src="bazel.BUILD" dest="BUILD" />
  </project>

  <!-- Build  -->
  <project path="build/make" name="build" groups="pdk,sysui-studio" remote="euclid" >
    <linkfile dest="build/CleanSpec.mk" src="CleanSpec.mk" />
    <linkfile dest="build/buildspec.mk.default" src="buildspec.mk.default" />
    <linkfile dest="build/core" src="core" />
    <linkfile dest="build/envsetup.sh" src="envsetup.sh" />
    <linkfile dest="build/target" src="target" />
    <linkfile dest="build/tools" src="tools" />
  </project>
  <project path="build/soong" name="build_soong" groups="pdk,tradefed,sysui-studio" remote="euclid" >
    <linkfile dest="Android.bp" src="root.bp" />
    <linkfile dest="bootstrap.bash" src="bootstrap.bash" />
  </project>
  
  <!-- Device  -->
  <project path="device/lineage/sepolicy" name="device_lineage_sepolicy" remote="euclid" />
  
  <!-- External  -->
  <project path="external/bouncycastle" name="external_bouncycastle" groups="pdk" remote="euclid" />
  <project path="external/arm-optimized-routines" name="external_arm-optimized-routines" groups="pdk" remote="euclid" />
  <project path="external/FadingEdgeLayout" name="external_FadingEdgeLayout" groups="pdk" remote="euclid" />
  <project path="external/piex" name="external_piex" groups="pdk" remote="euclid" />
  <project path="external/lz4" name="external_lz4" groups="pdk" remote="euclid" />

  <!-- Hardware -->
