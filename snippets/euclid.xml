  <project path="frameworks/opt/net/wifi" name="frameworks_opt_net_wifi" groups="pdk,sysui-studio" remote="euclid" />

  <!-- Kernel -->
  <project path="kernel/configs" name="kernel_configs" groups="vts,pdk" remote="euclid" />

  <!-- euclid Packages  -->
  <project path="packages/apps/Contacts" name="packages_apps_Contacts" groups="pdk-fs" remote="euclid" />
  <project path="packages/apps/ColumbusService" name="packages_apps_ColumbusService" remote="euclid" />
  <project path="packages/apps/Dialer" name="packages_apps_Dialer" groups="pdk-fs" remote="euclid" />
